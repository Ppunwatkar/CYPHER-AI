# ==============================================================================
# CIPHER AI Backend Configuration (Phase 1)
# ==============================================================================

# Application Settings
APP_NAME="CIPHER AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development | staging | production
DEBUG=false
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# CORS Origins (JSON list or comma-separated URLs; never use * in production)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Primary PostgreSQL Connection
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me_to_a_secure_password"
POSTGRES_DB="cipher_db"
POSTGRES_PORT=5432
POSTGRES_HOST="localhost"
DATABASE_URL="postgresql+asyncpg://postgres:change_me_to_a_secure_password@localhost:5432/cipher_db"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_PRE_PING=true

# Request Settings
REQUEST_TIMEOUT_SECONDS=30

# JWT & Authentication Security (Phase 2C)
JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

